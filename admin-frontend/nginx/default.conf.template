map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      '';
}

upstream amony_backend {
  server ${AMONY_BACKEND};
}

server {
  listen 80;
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  client_max_body_size 15g;

  location /api/ {
    proxy_pass http://amony_backend;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # $http_host (unlike $host) preserves the port, which the backend needs when deriving the OAuth redirect origin.
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;

    # Stream responses (log tailing / SSE) instead of buffering them.
    proxy_buffering off;
    proxy_read_timeout 1200s;
    proxy_send_timeout 1200s;
  }

  location /resources/ {
    proxy_pass http://amony_backend;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header Range $http_range;
    proxy_set_header If-Range $http_if_range;
    proxy_read_timeout 1200s;
    proxy_send_timeout 1200s;
  }

  # SPA fallback
  location / {
    try_files $uri $uri/ /index.html;
  }
}
