# --- Amony app config

# The location of your media files on the host machine (will be mounted as a volume in the Docker container)
AMONY_HOST_MEDIA_PATH=/path/to/your/media

# Local path to store application data (will be mounted as a volume in the Docker container).
# Data includes:
# - Postgres data directory (database files)
# - Dex data directory (authentication provider data)
# - Solr data directory (search index data)
AMONY_DATA=./data

# the user ID to use for the Amony process inside the Docker container (should match your host user ID to avoid permission issues with mounted volumes)
AMONY_DOCKER_USER_ID=1000

# When false then authentication is COMPLETELY disabled and EVERYONE has admin access and ALL other auth config is ignored
# Only useful for purely local deployment or testing. Do NOT use in production!
AMONY_AUTH_ENABLED=true

# When true, anonymous users are not allowed to access anything and are redirected to a login page.
# When false, anonymous users can access whatever the access-control.anonymous permissions allow.
AMONY_AUTH_REQUIRE_LOGIN=false

# How long a federated login attempt stays valid (the oauth_login_state cookie and server-side state). Default: 300 seconds.
AMONY_IDP_STATE_EXPIRATION=300 seconds

# the secret key used to sign JWT tokens for authentication
AMONY_JWT_SECRET_KEY=example_jwt_secret_key

# Hosts the backend accepts (Host / X-Forwarded-Host). Requests with any other host are rejected,
# so a client cannot make the backend act on a foreign domain. Defaults cover local development;
# for a deployment set the public hosts (the HTTPS setup derives these from the DOMAIN_* vars).
# AMONY_ALLOWED_HOSTS_0=demo.app.example

DATABASE_USERNAME=postgres
DATABASE_PASSWORD=changeme

# --- Postgres backup config (enable with: docker compose --profile backup)

# Cron schedule (default: daily at 2 AM)
BACKUP_SCHEDULE=0 2 * * *
# Days to keep old backups
BACKUP_RETENTION_DAYS=30
# Run a backup immediately when container starts
BACKUP_ON_STARTUP=false

# Postgres restore (enable with: docker compose --profile restore)
RESTORE_FILE=amony_20250101_020000.sql.gz  # Backup filename to restore (from BACKUP_HOST_PATH)

# --- Identity provider config

# Fixed roles granted to a user whose provider supplies none through the roles claim.
# AMONY_IDP_DEFAULT_ROLES=admin

# --- Dex

DEX_ADMIN_EMAIL=admin@app.example
DEX_ADMIN_USERNAME=admin
# bcrypt hash of the admin password (generate with: htpasswd -nbBC 10 "" 'yourpassword' | cut -d: -f2)
DEX_ADMIN_PASSWORD_HASH=$2a$10$2b2cU8CPhOTaGrs1HRQuAueS7JTT5ZHsHSzYiFPm1leZck7Mc8T4W

# Shared OAuth client secret for the "amony-app" client; Dex reads it directly and compose maps it to AMONY_IDP_CLIENT_SECRET.
DEX_CLIENT_SECRET=amony-dex-secret

# Optional: when set, logging out also redirects to the provider's end-session endpoint (OIDC RP-Initiated Logout).
# AMONY_IDP_END_SESSION_URL=http://localhost:5556/dex/logout

# Values rendered into docker/dex/config.yaml.tmpl.
# DEX_ISSUER=http://localhost:5556/dex
# DEX_AMONY_REDIRECT_URI=http://localhost:8182/api/auth/callback/dex,http://localhost:5173/api/auth/callback/dex

# --- Zitadel (trial identity provider; enable with: docker compose --profile zitadel up -d)
# ZITADEL_VERSION=v4.15.3
# Exactly 32 characters; encrypts Zitadel secrets at rest. Generate with: openssl rand -base64 48 | tr -dc 'a-zA-Z0-9' | head -c 32
# ZITADEL_MASTERKEY=MasterkeyNeedsToHave32Characters
# ZITADEL_ADMIN_PASSWORD=Password1!
# ZITADEL_ADMIN_USERNAME=admin@example.com
# ZITADEL_ORG_NAME=ZITADEL
# ZITADEL_ALLOW_REGISTER=false
# ZITADEL_EXTERNAL_DOMAIN=localhost
# ZITADEL_EXTERNAL_PORT=8080
# "external" when TLS is terminated by a reverse proxy, "disabled" for plain HTTP (local default).
# ZITADEL_TLS_MODE=disabled

# --- SSL config
# The top level domain for your application (e.g. app.example)
DOMAIN_TLD=app.example
# The subdomain for the Amony application (e.g. demo.app.example -> subdomain is "demo")
DOMAIN_SUB_AMONY=demo
# The subdomain for the authentication provider (e.g. account.app.example -> subdomain is "account")
DOMAIN_SUB_AUTH=account

PORKBUN_API_KEY=dummy
PORKBUN_SECRET_KEY=dummy
LETSENCRYPT_EMAIL=ops@app.example