# Non-secret configuration for the public demo deployment (https://demo.amony.app).

# --- Amony app config
AMONY_HOST_MEDIA_PATH=/home/docker-user/amony/media
AMONY_DATA=./data
AMONY_DOCKER_USER_ID=1000
AMONY_AUTH_ENABLED=true
AMONY_AUTH_PUBLIC_URI=https://demo.amony.app

DATABASE_USERNAME=postgres

# --- Postgres backup config
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_ON_STARTUP=false
RESTORE_FILE=amony_20250101_020000.sql.gz

# --- SSL config
DOMAIN_TLD=amony.app
DOMAIN_SUB_AMONY=demo
DOMAIN_SUB_AUTH=account
LETSENCRYPT_EMAIL=ops@mvisoftware.dev

# --- Identity provider (Zitadel)

# The demo authenticates through Zitadel. The app reaches it over the internal compose network, but
# Zitadel resolves the instance by request host, so the instance host is sent explicitly on the
# server-side token/userinfo calls. It must match the issuer (Zitadel's public origin): no port for
# the default https port. Secrets (ZITADEL_MASTERKEY, ZITADEL_ADMIN_PASSWORD and the OIDC client
# id/secret) are provided by the deploy workflow from GitHub secrets.
AMONY_IDP_NAME=zitadel
AMONY_IDP_ROLES_CLAIM=urn:zitadel:iam:org:project:roles
AMONY_IDP_ROLES_FROM=object-keys
# Zitadel supplies roles through the claim; an empty value disables the admin fallback that
# docker-compose.yml sets for the local Dex flow.
AMONY_IDP_DEFAULT_ROLES=
AMONY_IDP_AUTHORIZE_URL=https://account.amony.app/oauth/v2/authorize
AMONY_IDP_TOKEN_URL=http://zitadel:8080/oauth/v2/token
AMONY_IDP_USERINFO_URL=http://zitadel:8080/oidc/v1/userinfo
AMONY_IDP_END_SESSION_URL=https://account.amony.app/oidc/v1/end_session
AMONY_IDP_EXTRA_HEADERS="X-Zitadel-Instance-Host: account.amony.app"

# Zitadel instance public origin.
ZITADEL_EXTERNAL_DOMAIN=account.amony.app
ZITADEL_EXTERNAL_PORT=443
