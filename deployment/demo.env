# Non-secret configuration for the public demo deployment (https://demo.amony.app).
#
# This file is committed and versioned. The sensitive values (database password, JWT secret,
# Dex client secrets and admin password hash, Porkbun API credentials) are stored as GitHub
# Environment secrets named after their variable, and appended to a copy of this file by
# .github/workflows/deploy-demo.yml to produce the server's .env.
#
# See .env.example for the full set of options and docker-compose-https.yml for how the
# DOMAIN_* values below are turned into the public URLs / allowed hosts.

# --- Amony app config
AMONY_HOST_MEDIA_PATH=/home/docker-user/amony/media
AMONY_DATA=./data
AMONY_DOCKER_USER_ID=1000
AMONY_AUTH_ENABLED=true
AMONY_AUTH_PUBLIC_URI=https://demo.amony.app

DATABASE_USERNAME=postgres

# --- Postgres backup config
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_ON_STARTUP=false
RESTORE_FILE=amony_20250101_020000.sql.gz

# --- SSL config
DOMAIN_TLD=amony.app
DOMAIN_SUB_AMONY=demo
DOMAIN_SUB_ADMIN=admin
DOMAIN_SUB_AUTH=account
LETSENCRYPT_EMAIL=ops@mvisoftware.dev
