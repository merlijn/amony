user nginx;
worker_processes auto;
pid /run/nginx.pid;
error_log /dev/stderr;

load_module modules/ngx_http_headers_more_filter_module.so;

events {
	worker_connections 768;
	# multi_accept on;
}

http {

  # Enable DNS resolution for Docker service names
  resolver 127.0.0.11 valid=60s;

  # Map to handle both WebSocket upgrades and SSE streaming
  map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      '';
  }

  map $remote_addr $rate_limit_key {
      # IPv6: extract /64 prefix (first 4 groups)
      "~^(?<ipv6_prefix>[0-9a-fA-F]+:[0-9a-fA-F]+:[0-9a-fA-F]+:[0-9a-fA-F]+):" $ipv6_prefix;
      # IPv4 or fallback
      default $remote_addr;
  }

  # Flood limit for the auth provider. Zitadel's console loads many assets at once and its APIs
  # return 4xx normally, so the limit is generous and upstream responses are not intercepted.
  limit_req_zone $rate_limit_key zone=auth_baseline:10m rate=50r/s;

  proxy_headers_hash_max_size 1024;
  proxy_headers_hash_bucket_size 128;

	types_hash_max_size 2048;
	server_tokens off; # Hide build/version details

	ssl_protocols TLSv1.2 TLSv1.3; # Dropping SSLv3 (POODLE), TLS 1.0, 1.1
	ssl_prefer_server_ciphers off; # Don't force server cipher order.

	access_log /var/log/nginx/access.log;

	gzip on;

	# Upstream for amony backend
	upstream amony_backend {
		zone amony_backend 64k;
		server amony-app:8182 resolve;
	}

	# Upstream for auth provider
	upstream auth_backend {
		zone auth_backend 64k;
		server ${AUTH_UPSTREAM} resolve;
	}

	# Default SSL server - close unknown connections
	server {
		listen 443 ssl default_server;
		server_name _;

		include ssl-certificate.conf;

		# Close connection without response
		return 444;
	}

	# Media server
	server {
		listen 443 ssl;
		server_name ${DOMAIN_SUB_AMONY}.${DOMAIN_TLD};

		include ssl-certificate.conf;
		include shared-proxy-settings.conf;

		proxy_connect_timeout 60s;
		proxy_send_timeout    1200s;
		proxy_read_timeout    1200s;

		client_max_body_size 15g;

		location / {
			proxy_request_buffering off;
			proxy_pass http://amony_backend;
		}
	}

	# Auth provider
	server {
		listen 443 ssl;
		server_name ${DOMAIN_SUB_AUTH}.${DOMAIN_TLD};

		include ssl-certificate.conf;
		include shared-proxy-settings.conf;

		proxy_connect_timeout 60s;
		proxy_send_timeout    60s;
		proxy_read_timeout    60s;

		location / {
			# A large burst covers the console's parallel asset loads; upstream 4xx pass through untouched.
			limit_req zone=auth_baseline burst=200 nodelay;
			limit_req_status 429;

			proxy_pass http://auth_backend;
		}
	}
}
