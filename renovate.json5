{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended"],

  // config:recommended groups dependencies of the same monorepo into their own PRs; we want one
  // minor/patch PR per stack instead.
  ignorePresets: ["group:monorepos", "group:recommended"],

  // Keep the digest next to every image tag, so a tag that moves (postgres:17) shows up as an
  // explicit PR instead of silently changing on the next pull.
  pinDigests: true,

  // Minor/patch updates are batched per stack, so the default of 2 is too low for a first run.
  prHourlyLimit: 10,

  // Maven Central rate-limits metadata lookups and 429s the hosted app's shared egress. Renovate
  // defaults to 16 concurrent requests and no throttle, which is what trips the limiter.
  hostRules: [
    {
      matchHost: "repo.maven.apache.org",
      concurrentRequestLimit: 4,
      maxRequestsPerSecond: 3,
    },
  ],

  // The Jib base image reference lives in build.sbt; the "Build base image" workflow publishes a new
  // timestamp tag per build and this manager keeps the reference in step.
  customManagers: [
    {
      customType: "regex",
      fileMatch: ["^backend/build\\.sbt$"],
      matchStrings: ["val baseImageTag = \"(?<currentValue>[^\"]+)\""],
      depNameTemplate: "merlijn/amony-base",
      datasourceTemplate: "docker",
      registryUrlTemplate: "https://ghcr.io",
      versioningTemplate: "docker",
    },
  ],

  packageRules: [
    // Day-to-day updates are rolled up per stack: one PR for the frontend, one for the backend.
    {
      matchManagers: ["npm"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "frontend minor/patch dependencies",
    },
    {
      matchManagers: ["sbt"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "backend minor/patch dependencies",
    },

    // pnpm rejects lockfile entries younger than 24 hours, so proposing a fresh release only
    // produces a red build; wait until the package has aged past that cutoff.
    {
      matchDatasources: ["npm"],
      minimumReleaseAge: "1 day",
    },

    // Maven Central rate-limits metadata lookups; Google's public mirror serves the same artifacts
    // with its own limits. sbt deps use the sbt-package datasource, plain Java ones maven. The
    // sbt-plugin datasource is left alone: it needs HTML directory listings, which mirrors don't do.
    {
      matchDatasources: ["maven", "sbt-package"],
      registryUrls: ["https://maven-central.storage-download.googleapis.com/maven2"],
    },

    // Scala and Node are pinned to an LTS line (3.9.x and 26.x) and moved to a new line by hand;
    // patch releases inside the line still flow.
    {
      matchPackageNames: ["org.scala-lang:scala3-library_3"],
      matchUpdateTypes: ["minor", "major"],
      enabled: false,
    },
    {
      matchDatasources: ["node-version"],
      matchPackageNames: ["node"],
      matchUpdateTypes: ["minor", "major"],
      enabled: false,
    },

    // Base image builds always get their own PR, never folded into the backend group.
    {
      matchPackageNames: ["merlijn/amony-base"],
      groupName: "base image",
    },

    // Majors are always a separate PR, whichever stack they come from.
    {
      matchUpdateTypes: ["major"],
      labels: ["major-update"],
    },

    // Docker images are pinned to a moving stream tag plus a digest. Digest PRs keep them patched
    // within that stream; rewriting the tag to a more specific version is not wanted.
    {
      matchManagers: ["docker-compose", "dockerfile"],
      matchUpdateTypes: ["minor", "patch"],
      enabled: false,
    },
    // These publish no moving stream tag, so version bumps are the only way they get updates.
    {
      matchManagers: ["docker-compose", "dockerfile"],
      matchPackageNames: [
        "dexidp/dex",
        "otel/opentelemetry-collector",
        "ghcr.io/zitadel/zitadel",
      ],
      matchUpdateTypes: ["minor", "patch"],
      enabled: true,
    },
    // Built on the host or by CI, not something Renovate can look up.
    {
      matchPackageNames: ["amony/certbot", "ghcr.io/merlijn/amony-app"],
      enabled: false,
    },
  ],
}
